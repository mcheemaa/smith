{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": { "includes": ["src/**", "test/**", "*.json"] },
  "formatter": { "indentStyle": "tab", "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "preset": "recommended", "suspicious": { "noExplicitAny": "error" } } },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "overrides": [{ "includes": ["*.json"], "formatter": { "indentStyle": "space", "indentWidth": 2 } }]
}
