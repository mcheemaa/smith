# Claude. Sign in on this machine with `claude auth login`, or paste a long-lived token from `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=
# An API key works too and takes precedence when set.
# ANTHROPIC_API_KEY=

SMITH_NAME=Smith
# SMITH_HOME=/home/smith/.smith
# Comma-separated git URLs, cloned into the workspace on first start.
SMITH_REPOS=git@github.com:you/repo-one.git,git@github.com:you/repo-two.git
# SMITH_MODEL=claude-fable-5-1
# SMITH_FALLBACK_MODEL=claude-opus-5
# SMITH_EFFORT=high
# SMITH_MAX_TURNS=300
# SMITH_MAX_CONCURRENT=4
# SMITH_RUN_TIMEOUT_MINUTES=120
# A conversation idle for longer starts a fresh session next time.
# SMITH_SESSION_IDLE_HOURS=24

# Slack. Create the app from deploy/slack-manifest.yaml; both tokens come from its settings pages.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# Comma-separated Slack user IDs allowed to talk to the agent. Empty means anyone in the workspace.
SLACK_ALLOWED_USERS=U0123456789
# The person the heartbeat reports to. Defaults to the first allowed user.
# SLACK_OWNER=U0123456789
# Channel ID for heartbeat reports. Leave unset to keep them in the log.
# SLACK_HEARTBEAT_CHANNEL=C0123456789
# Cron expression for the heartbeat. Empty disables it.
# HEARTBEAT_CRON=0 */4 * * *

# Tools the agent gets through .mcp.json in its workspace. Leave a value unset to leave that tool out.
# NOTION_TOKEN=ntn_...            an internal integration, shared with the pages it may use
# DATABASE_URL_READONLY=postgres://...   a read-only role; the server refuses writes as well
# RESEND_API_KEY=re_...            for sending email
# RESEND_FROM="Smith <smith@example.com>"
# TRIGGER_ACCESS_TOKEN=tr_pat_...  a Trigger.dev personal access token

# Linear. Optional. The agent application's client ID and secret (client credentials must be enabled on the app) and its webhook signing secret.
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# LINEAR_WEBHOOK_SECRET=
# PORT=8787

# Vercel access token for the vercel CLI, from vercel.com/account/settings/tokens
# VERCEL_TOKEN=
