# Claude. Sign in on this machine with `claude auth login`, or paste a long-lived token from `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=
# An API key works too and takes precedence when set.
# ANTHROPIC_API_KEY=

SMITH_NAME=Smith
# SMITH_HOME=/home/smith/.smith
# Comma-separated git URLs, cloned into the workspace on first start.
SMITH_REPOS=git@github.com:you/repo-one.git,git@github.com:you/repo-two.git
# SMITH_MODEL=claude-fable-5-1
# SMITH_FALLBACK_MODEL=claude-opus-5
# SMITH_EFFORT=high
# SMITH_MAX_TURNS=300
# SMITH_MAX_CONCURRENT=4
# SMITH_RUN_TIMEOUT_MINUTES=120
# A conversation idle for longer starts a fresh session next time.
# SMITH_SESSION_IDLE_HOURS=24

# Slack. Create the app from deploy/slack-manifest.yaml; both tokens come from its settings pages.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# Comma-separated Slack user IDs allowed to talk to the agent. Empty means anyone in the workspace.
SLACK_ALLOWED_USERS=U0123456789
# Channel ID for heartbeat reports. Leave unset to keep them in the log.
# SLACK_HEARTBEAT_CHANNEL=C0123456789
# Cron expression for the heartbeat. Empty disables it.
# HEARTBEAT_CRON=0 */4 * * *

# Linear. Optional. The OAuth token of the agent app (actor=app) and the webhook signing secret.
# LINEAR_ACCESS_TOKEN=
# LINEAR_WEBHOOK_SECRET=
# PORT=8787
