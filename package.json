{
  "name": "smith",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted engineering agent on the Claude Agent SDK. Talks in Slack, works Linear, ships pull requests.",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "linear-auth": "bun run scripts/linear-auth.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "@linear/sdk": "^95.1.0",
    "@slack/bolt": "4.7.3",
    "@slack/web-api": "^7.19.0",
    "croner": "^10.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
